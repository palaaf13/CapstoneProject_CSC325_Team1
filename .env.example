# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Atlas
# Full SRV connection string from Atlas -> Connect -> Drivers.
# django-mongodb-backend 6.1 reads the whole URI as the database HOST.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=ramhub

# RamHub
COLLEGE_EMAIL_DOMAIN=farmingdale.edu

# Email (development uses the console backend; production requires an SMTP host
# and a sender address authorized by your mail provider)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=RamHub <noreply@example.com>
